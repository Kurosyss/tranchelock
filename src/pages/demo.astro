        "  Agent Balance:    $50.00 TLUSD"
      ]
    },
    {
      phase: 5,
      label: "PHASE 5 // ADVERSARIAL TEST: FAILED IMPLEMENTATION",
      title: "Agent submits buggy code (m2_broken.py); Verifier REJECTS",
      desc: "Agent submits unpatched code with unhandled negative n and empty list cases. Test runner catches 2 uncaught exceptions. Exit code is 1. Verifier issues ZERO signatures.",
      vaultBalance: "$50.00",
      agentBalance: "$50.00",
      vaultStatus: "ACTIVE",
      m1Status: "RELEASED",
      m2Status: "FAILED (REJECTED)",
      logs: [
        "--- [STEP 5] ADVERSARIAL CASE: AGENT SUBMITS DEFECTIVE CODE ---",
        "  Target File: fixtures/agent_submissions/m2_broken.py",
