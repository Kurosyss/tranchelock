        "  Signature: 84725d2b78d2b7579124be30357ea1b5a2bf2a4208e923b72c41c7b5fa3245bb..."
      ]
    },
    {
      phase: 4,
      label: "PHASE 4 // SOLANA ED25519 INTROSPECTION & SETTLEMENT",
      title: "Solana verifies Ed25519 instruction & releases Tranche 0 (+$50.00)",
      desc: "Solana runtime verifies that the Ed25519 precompile instruction immediately precedes release_tranche. Tranche 0 releases $50.00 TLUSD directly to agent token account.",
      vaultBalance: "$50.00",
      agentBalance: "$50.00",
      vaultStatus: "ACTIVE",
      m1Status: "RELEASED",
      m2Status: "LOCKED",
      logs: [
        "--- [STEP 4] SOLANA INSTRUCTION INTROSPECTION & DISBURSEMENT ---",
        "  Executing release_tranche(nonce=1001, milestone_idx=0, amount=50000000)...",
        "  [OK] Sysvar instruction introspection check: index current - 1 is Ed25519 program",
        "  [OK] Signature verified onchain: 84725d2b78d2...",
        "  [OK] Mismatched spec hash check: PASSED",
