      vaultBalance: "$0.00",
      agentBalance: "$100.00",
      vaultStatus: "COMPLETED",
      m1Status: "RELEASED",
      m2Status: "RELEASED",
      logs: [
        "--- [STEP 7] SOLANA RELEASES FINAL TRANCHE 1 ($50.00 TLUSD) ---",
        "  [OK] Solana verifies second Ed25519 instruction immediately preceding release",
        "  [OK] Nonce: 1003 verified; milestone_idx: 1",
        "  Released Amount:  +$50.00 TLUSD -> Agent Wallet",
        "  Vault Remaining:  $0.00 TLUSD",
        "  Agent Final Total: $100.00 TLUSD (100% of committed capital settled)",
        "--- [STEP 12] VAULT REACHES FINAL ONCHAIN STATE: COMPLETED ---",
        "===========================================================================",
        "  DEMO FINISHED SUCCESSFULLY: ALL 7 PHASES VERIFIED & REPRODUCIBLE",
        "==========================================================================="
      ]
    }
  ];

  let currentPhaseIdx = 0;
  let autoplayInterval = null;

  function renderPhase(idx) {
    currentPhaseIdx = idx;
    const data = demoPhases[idx];

    const labelEl = document.getElementById("demo-step-label");
    const titleEl = document.getElementById("demo-step-title");
    const descEl = document.getElementById("demo-step-description");
    const stepNumEl = document.getElementById("demo-step-num");
    if (labelEl) labelEl.textContent = data.label;
    if (stepNumEl) stepNumEl.textContent = String(data.phase);
    if (titleEl) titleEl.textContent = data.title;
    if (descEl) descEl.textContent = data.desc;

    const vaultBalEl = document.getElementById("demo-vault-balance");
    const agentBalEl = document.getElementById("demo-agent-balance");
    if (vaultBalEl) vaultBalEl.textContent = data.vaultBalance;
    if (agentBalEl) agentBalEl.textContent = data.agentBalance;

    const agentStatusEl = document.getElementById("demo-agent-status");
    if (agentStatusEl) {
      if (data.agentBalance === "$100.00") {
        agentStatusEl.textContent = "100% Settled & Inviolable";
        agentStatusEl.className = "text-[11px] font-sans text-[#10b981] font-medium mt-0.5";
      } else if (data.agentBalance === "$50.00") {
        agentStatusEl.textContent = "Tranche 0 Settled (+$50.00)";
        agentStatusEl.className = "text-[11px] font-sans text-[#10b981] font-medium mt-0.5";
      } else {
        agentStatusEl.textContent = "Awaiting Verification";
        agentStatusEl.className = "text-[11px] font-sans text-[#8f8f8f] mt-0.5";
      }
    }

    const vaultBadge = document.getElementById("demo-vault-status-badge");
    if (vaultBadge) {
      vaultBadge.textContent = data.vaultStatus;
      vaultBadge.className = data.vaultStatus === "COMPLETED" 
        ? "pixel-grid text-[10px] text-[#10b981] bg-[#10b981]/10 px-2 py-0.5 rounded border border-[#10b981]/25 font-semibold"
        : "pixel-square text-[10px] text-[#171717] bg-[#f2f2f2] px-2 py-0.5 rounded border border-[#ebebeb]";
    }

    const m1Badge = document.getElementById("demo-m1-badge");
    if (m1Badge) {
      m1Badge.textContent = data.m1Status;
      m1Badge.className = data.m1Status === "RELEASED"
        ? "text-[10px] font-mono text-[#10b981] bg-[#10b981]/10 px-1.5 py-0.5 rounded border border-[#10b981]/25"
        : "text-[10px] font-mono text-[#8f8f8f] bg-white px-1.5 py-0.5 rounded border border-[#ebebeb]";
    }

    const m2Badge = document.getElementById("demo-m2-badge");
    if (m2Badge) {
      m2Badge.textContent = data.m2Status;
      m2Badge.className = data.m2Status.includes("FAIL")
        ? "text-[10px] font-mono text-[#ee0000] bg-[#ee0000]/10 px-1.5 py-0.5 rounded border border-[#ee0000]/25 font-semibold"
        : data.m2Status === "RELEASED"
        ? "text-[10px] font-mono text-[#10b981] bg-[#10b981]/10 px-1.5 py-0.5 rounded border border-[#10b981]/25"
        : "text-[10px] font-mono text-[#8f8f8f] bg-white px-1.5 py-0.5 rounded border border-[#ebebeb]";
    }

    for (let i = 1; i <= 7; i++) {
      const node = document.getElementById(`phase-node-${i}`);
      if (node) {
        if (i === data.phase) {
          node.className = "phase-node flex items-center gap-2 px-3 py-1.5 rounded-[4px] bg-[#171717] border border-[#171717] text-white font-medium";
        } else if (i < data.phase) {
          node.className = "phase-node flex items-center gap-2 px-3 py-1.5 rounded-[4px] bg-[#10b981]/10 border border-[#10b981]/30 text-[#10b981]";
        } else {
          node.className = "phase-node flex items-center gap-2 px-3 py-1.5 rounded-[4px] bg-[#fafafa] border border-[#ebebeb] text-[#8f8f8f]";
        }
      }
    }

    const terminal = document.getElementById("demo-terminal-body");
    if (terminal) {
      const separator = document.createElement("div");
      separator.className = "text-[#ebebeb] pt-2 font-mono";
      separator.textContent = "---------------------------------------------------------------------------";
      terminal.appendChild(separator);

      data.logs.forEach(line => {
        const div = document.createElement("div");
        if (line.includes("[OK]") || line.includes("PASSED") || line.includes("[+]")) {
          div.className = "text-[#10b981] font-mono";
        } else if (line.includes("FAILED") || line.includes("[!]")) {
          div.className = "text-[#ee0000] font-mono font-medium";
        } else if (line.includes("---")) {
          div.className = "text-[#171717] font-mono font-semibold pt-1";
        } else {
          div.className = "text-[#4d4d4d] font-mono";
        }
        div.textContent = line;
        terminal.appendChild(div);
      });
      terminal.scrollTop = terminal.scrollHeight;
    }
  }

  function setupDemo() {
    const btnNext = document.getElementById("btn-next-step");
    const btnPrev = document.getElementById("btn-prev-step");
    const btnReset = document.getElementById("btn-reset");
    const btnAuto = document.getElementById("btn-autoplay");

    if (btnNext) {
      btnNext.addEventListener("click", () => {
        if (currentPhaseIdx < demoPhases.length - 1) {
          renderPhase(currentPhaseIdx + 1);
        }
      });
    }

    if (btnPrev) {
      btnPrev.addEventListener("click", () => {
        if (currentPhaseIdx > 0) {
          renderPhase(currentPhaseIdx - 1);
        }
      });
    }

    if (btnReset) {
      btnReset.addEventListener("click", () => {
        if (autoplayInterval) clearInterval(autoplayInterval);
        const terminal = document.getElementById("demo-terminal-body");
        if (terminal) {
          terminal.innerHTML = `
            <div class="text-[#ebebeb] font-mono select-none">---------------------------------------------------------------------------</div>
            <div class="text-[#171717] font-mono font-medium">  TRANCHELOCK VERIFICATION HARNESS // 7-PHASE END-TO-END DEMO</div>
            <div class="text-[#ebebeb] font-mono select-none pb-1">---------------------------------------------------------------------------</div>
            <div class="flex flex-col gap-1 py-1 text-[11px] sm:text-[12px] border-b border-[#ebebeb]/80">
              <div><span class="font-mono text-[#8f8f8f]">  Sponsor Wallet:  </span><span class="font-mono text-[#171717]">9cxHstyCEHRAazJJuL3FrpMH6LJsKSPLP5Vouo4yWYwV</span></div>
              <div><span class="font-mono text-[#8f8f8f]">  Agent Wallet:    </span><span class="font-mono text-[#171717]">3a5rCTRmQ9B74GnietwFSfqKJirEHjqZdEaCMQeSnksP</span></div>
              <div><span class="font-mono text-[#8f8f8f]">  Vault PDA:       </span><span class="font-mono text-[#171717]">GbkWd144roWeT7uE1KxEJVQ2Wvk3ZV84vLp6hUii6Kno</span></div>
              <div><span class="font-mono text-[#8f8f8f]">  Verifier Oracle: </span><span class="font-mono text-[#171717]">HyiP6tqPGE9wX6oBNPeS8eBhhsEpKar4VzQphRWVGf5W</span></div>
              <div><span class="font-mono text-[#8f8f8f]">  Milestone 1 Hash:</span><span class="font-mono text-[#171717]">49bf07f8d8bfe3e4...</span></div>
              <div><span class="font-mono text-[#8f8f8f]">  Milestone 2 Hash:</span><span class="font-mono text-[#171717]">3c8d0a8a68b5ce08...</span></div>
            </div>
            <div class="text-[#10b981] font-mono font-medium pt-2">&gt; Demo reset. Click <span class="font-mono text-[#171717] font-semibold">[Next Step &rarr;]</span> or <span class="font-mono text-[#171717] font-semibold">[Auto-play 90s Tour]</span> to begin.</div>
          `;
        }
        renderPhase(0);
      });
    }

    if (btnAuto) {
      btnAuto.addEventListener("click", () => {
        if (autoplayInterval) {
          clearInterval(autoplayInterval);
          autoplayInterval = null;
          btnAuto.innerHTML = "<span class='w-1.5 h-1.5 rounded-full bg-[#10b981]'></span><span>Auto-play 90s Tour</span>";
          return;
        }

        btnAuto.innerHTML = "<span class='text-xs'>⏸</span><span>Pause Tour</span>";
        autoplayInterval = setInterval(() => {
          if (currentPhaseIdx < demoPhases.length - 1) {
            renderPhase(currentPhaseIdx + 1);
          } else {
            clearInterval(autoplayInterval);
            autoplayInterval = null;
            btnAuto.innerHTML = "<span class='w-1.5 h-1.5 rounded-full bg-[#10b981]'></span><span>Auto-play 90s Tour</span>";
          }
        }, 3200);
      });
    }
  }

  document.addEventListener("astro:page-load", setupDemo);
</script>
