---
import Badge from './ui/Badge.astro';
import TrancheLogo from './ui/TrancheLogo.astro';
import { ACTIVE_TOKEN } from '../config/tokens';
---

<footer class="border-t border-[#ebebeb] bg-[#fafafa] text-[#4d4d4d] text-xs mt-auto">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 py-16 flex flex-col gap-12">
    <!-- Top Row: Columns -->
    <div class="grid grid-cols-2 md:grid-cols-5 gap-8">
      <!-- Col 1: Protocol Info -->
      <div class="col-span-2 flex flex-col gap-3">
        <div class="flex items-center gap-2.5">
          <TrancheLogo size={28} class="w-[28px] h-[28px]" />
          <span class="font-semibold text-[#171717] tracking-tight">TRANCHELOCK</span>
          <span class="text-[10px] font-mono text-[#8f8f8f] bg-[#f2f2f2] px-1.5 py-0.5 rounded border border-[#ebebeb]">COLOSSEUM 2026</span>
        </div>
        <p class="type-body-sm max-w-sm">
          Autonomous coding agents cannot be trusted with upfront lump sums. 
          TrancheLock locks capital in Solana escrow vaults, releasing funds only when sandboxed code passes sponsor assertions and Gemini reasoning.
        </p>
        <div class="pt-1 text-[11px] text-[#8f8f8f]">
          <span class="font-sans">Settlement Token:</span> <a href={ACTIVE_TOKEN.explorerUrl} target="_blank" class="font-sans text-[#171717] hover:underline">{ACTIVE_TOKEN.symbol} ({ACTIVE_TOKEN.name})</a> <span class="font-mono text-[10px]">({ACTIVE_TOKEN.mint.slice(0, 8)}...{ACTIVE_TOKEN.mint.slice(-6)})</span>
        </div>
      </div>

      <!-- Col 2: Protocol -->
      <div class="flex flex-col gap-2.5">
        <span class="type-mono-eyebrow text-[#171717]">PROTOCOL</span>
        <a href="/" class="text-[#4d4d4d] hover:text-[#171717] transition-colors">Overview</a>
        <a href="/app" class="text-[#4d4d4d] hover:text-[#171717] transition-colors">Active Vaults</a>
        <a href="/demo" class="text-[#4d4d4d] hover:text-[#171717] transition-colors flex items-center gap-1.5">
          <span>90s Interactive Demo</span>
          <span class="w-1.5 h-1.5 rounded-full bg-[#10b981]"></span>
        </a>
        <a href="/vault/GbkWd144roWeT7uE1KxEJVQ2Wvk3ZV84vLp6hUii6Kno" class="text-[#4d4d4d] hover:text-[#171717] transition-colors">Live Devnet Vault</a>
      </div>

      <!-- Col 3: Security & Proof -->
      <div class="flex flex-col gap-2.5">
        <span class="type-mono-eyebrow text-[#171717]">SECURITY</span>
        <a href="/security" class="text-[#4d4d4d] hover:text-[#171717] transition-colors flex items-center gap-1">
          <span>22 Invariant Tests</span>
          <span class="text-[9px] text-[#10b981] font-mono font-semibold">[PASS]</span>
        </a>
        <a href="/security" class="text-[#4d4d4d] hover:text-[#171717] transition-colors">Ed25519 Introspection</a>
        <a href="/security" class="text-[#4d4d4d] hover:text-[#171717] transition-colors">Replay Protection</a>
        <a href="/security" class="text-[#4d4d4d] hover:text-[#171717] transition-colors">Isolated Sandbox Model</a>
      </div>

      <!-- Col 4: Developers -->
      <div class="flex flex-col gap-2.5">
        <span class="type-mono-eyebrow text-[#171717]">DEVELOPERS</span>
        <a href="/docs" class="text-[#4d4d4d] hover:text-[#171717] transition-colors">Documentation</a>
        <a href="/docs" class="text-[#4d4d4d] hover:text-[#171717] transition-colors">Anchor Program Spec</a>
        <a href="/docs" class="text-[#4d4d4d] hover:text-[#171717] transition-colors">153-Byte Canonical Proof</a>
        <a href="/docs" class="text-[#4d4d4d] hover:text-[#171717] transition-colors">Timelock Clawback</a>
      </div>

      <!-- Col 5: Legal & Risk -->
      <div class="flex flex-col gap-2.5">
        <span class="type-mono-eyebrow text-[#171717]">LEGAL & RISK</span>
        <a href="/privacy" class="text-[#4d4d4d] hover:text-[#171717] transition-colors">Privacy Policy</a>
        <a href="/terms" class="text-[#4d4d4d] hover:text-[#171717] transition-colors">Terms of Use</a>
        <a href="/risk" class="text-[#4d4d4d] hover:text-[#171717] transition-colors">Risk Disclosure</a>
      </div>
    </div>

    <!-- Bottom Row: Metadata & Disclosures -->
    <div class="border-t border-[#ebebeb] pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] text-[#8f8f8f]">
      <div class="flex items-center gap-3">
        <span class="font-sans">Colosseum "Crypto World's Fair" Hackathon</span>
        <span>•</span>
        <span><span class="font-sans">Program ID:</span> <span class="font-mono text-[#171717]">3SBmcsZq...ebtM</span></span>
      </div>
      <div class="flex items-center gap-3 sm:gap-4 flex-wrap justify-center sm:justify-end">
        <span><span class="font-sans">Engine:</span> <span class="font-mono text-[#171717]">Gemini 2.5 Flash + Pytest</span></span>
        <span>•</span>
        <a href="/privacy" class="hover:text-[#171717] transition-colors">Privacy</a>
        <span>•</span>
        <a href="/terms" class="hover:text-[#171717] transition-colors">Terms</a>
        <span>•</span>
        <a href="/risk" class="hover:text-[#171717] transition-colors">Risk</a>
        <span>•</span>
        <span class="font-sans text-[#171717]">MIT License</span>
      </div>
    </div>
  </div>
</footer>
