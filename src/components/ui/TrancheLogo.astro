---
interface Props {
  size?: number;
  class?: string;
}

const { size = 28, class: className = '' } = Astro.props;
---

<img 
  src="/brand-mark.svg" 
  width={size} 
  height={size} 
  alt="TrancheLock" 
  class={`rounded-[6px] shadow-sm shrink-0 object-contain ${className}`}
  loading="eager"
  decoding="sync"
/>
