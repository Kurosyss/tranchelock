---
interface Props {
  text: string;
  label?: string;
  class?: string;
}

const { text, label, class: className = '' } = Astro.props;
---

<button
  type="button"
  data-copy={text}
  class={`copy-btn inline-flex items-center gap-1.5 px-2 py-1 rounded-[4px] bg-[#141417] hover:bg-[#1c1c20] border border-[#222226] hover:border-[#333339] text-[11px] font-mono text-[#A1A1AA] hover:text-[#EDEDED] transition-colors cursor-pointer select-none group ${className}`}
  title="Click to copy"
>
  <span class="copy-text">{label || text}</span>
  <svg class="w-3 h-3 copy-icon text-[#71717A] group-hover:text-[#EDEDED] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
  </svg>
  <svg class="w-3 h-3 check-icon text-[#10B981] hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
  </svg>
</button>

<script>
  function setupCopyButtons() {
    document.querySelectorAll('.copy-btn').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        e.stopPropagation();
        const textToCopy = btn.getAttribute('data-copy');
        if (!textToCopy) return;

        try {
          await navigator.clipboard.writeText(textToCopy);
          const icon = btn.querySelector('.copy-icon');
          const check = btn.querySelector('.check-icon');
          if (icon && check) {
            icon.classList.add('hidden');
            check.classList.remove('hidden');
            setTimeout(() => {
              icon.classList.remove('hidden');
              check.classList.add('hidden');
            }, 1800);
          }
        } catch (err) {
          console.error('Failed to copy text: ', err);
        }
      });
    });
  }

  // Setup on initial load and on Astro page swaps
  document.addEventListener('astro:page-load', setupCopyButtons);
</script>
