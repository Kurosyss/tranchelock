---
interface Props {
  class?: string;
  elevated?: boolean;
  padding?: 'none' | 'sm' | 'md' | 'lg' | 'xl';
  id?: string;
}

const { 
  class: className = '', 
  elevated = false,
  padding = 'md',
  id
} = Astro.props;

const paddingStyles = {
  none: 'p-0',
  sm: 'p-3.5',
  md: 'p-5',
  lg: 'p-6 sm:p-7',
  xl: 'p-8',
};
---

<div 
  id={id}
  class={`bg-[#0c0c0e] border border-[#222226] rounded-[10px] transition-all duration-150 ${elevated ? 'shadow-floating border-[#2a2a30]' : 'shadow-whisper'} ${paddingStyles[padding]} ${className}`}
>
  <slot />
</div>
